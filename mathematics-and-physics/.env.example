# Obtain from @BotFather. Never commit your real token.
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
# Create at https://platform.openai.com/api-keys (separate billing from ChatGPT subscription)
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Choose a model enabled in your API account.
OPENAI_MODEL=gpt-6.1-terra
# Daily AI messages per student, resets at 00:00 UTC
DAILY_AI_LIMIT=25
# Local database location
DATABASE_PATH=data/students.sqlite3
