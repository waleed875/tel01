# PostgreSQL and local from-scratch engineering AI. Do not commit .env.
POSTGRES_USER=tutor
POSTGRES_DB=engineering_tutor
# Choose a long random password without : / @ ? # % (URL delimiters)
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
MAX_NEW_TOKENS=180

GITEA_DB_PASSWORD=REPLACE_WITH_ANOTHER_LONG_RANDOM_PASSWORD
GITEA_OWNER=
GITEA_API_TOKEN=
